{# Rows are precomputed per-host as `fp_row` in play 2, so this template only formats. #}
{%- set rows = fp_audited | map('extract', hostvars, 'fp_row') | list -%}
{%- set ping_ok    = rows | selectattr('ping', 'eq', 'OK') | list -%}
{%- set port_ok    = rows | selectattr('port', 'eq', 'OK') | list -%}
{%- set ssh_ok     = rows | selectattr('ssh', 'eq', 'OK') | list -%}
{%- set icmp_only  = rows | selectattr('ping', 'eq', 'FAIL') | selectattr('port', 'eq', 'OK') | list -%}
{%- set log_done   = rows | selectattr('log', 'eq', 'removed') | list -%}
{%- set log_absent = rows | selectattr('log', 'eq', 'already absent') | list -%}
{%- set restarted  = rows | selectattr('restart', 'eq', 'restarted') | list -%}
{%- set reset_ran  = rows | selectattr('reset', 'search', '^ran ') | list -%}
{%- set reset_none = rows | selectattr('reset', 'eq', 'not present') | list -%}
{#- Dedupe by host: one unit can error in several stages and must still count once. -#}
{%- set errored    = (rows | selectattr('log', 'eq', 'ERROR') | list
                    + rows | selectattr('restart', 'eq', 'ERROR') | list
                    + rows | selectattr('reset', 'eq', 'ERROR') | list)
                    | unique(attribute='host') | list -%}
{#- Remote error text can contain '|', which would break every table it lands in. -#}
{%- macro cell(text) -%}
{{ text | replace('\n', ' ') | replace('|', '\\|') | truncate(90) }}
{%- endmacro -%}
